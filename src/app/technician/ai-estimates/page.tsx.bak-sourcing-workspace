function QuoteCard({ quote }: { quote: PartQuote }) {
  const confidence = confidenceLabel(quote.confidence);

  return (
    <div className="rounded-2xl border border-white/10 bg-black p-4">
      <div className="flex items-start justify-between gap-3">
        <div className="min-w-0">
          <p className="truncate font-black text-white">{quote.supplier_name}</p>
          <p className="mt-1 text-xs text-zinc-500">
            {quote.supplier_type || "supplier"} · {quote.part_condition || "condition unknown"}
          </p>
        </div>

        {(quote.selected_for_estimate || quote.is_recommended) && (
          <span className="rounded-full bg-emerald-500/10 px-2 py-1 text-[10px] font-black text-emerald-300">
            {quote.selected_for_estimate ? "Selected" : "Recommended"}
          </span>
        )}
      </div>

      <p className="mt-4 text-2xl font-black text-white">{currency(quote.price)}</p>

      <div className="mt-3 space-y-1 text-xs text-zinc-500">
        <p>{quote.availability || "Availability unknown"}</p>
        {quote.lead_time_days ? <p>Lead time: {quote.lead_time_days} day(s)</p> : null}
        {quote.part_number ? <p>Part no: {quote.part_number}</p> : null}
        {confidence ? <p>Confidence: {confidence}</p> : null}
        {quote.warranty_notes ? <p>{quote.warranty_notes}</p> : null}
      </div>

      {quote.source_url ? (
        <a
          href={quote.source_url}
          target="_blank"
          rel="noreferrer"
          className="mt-4 inline-flex text-xs font-black text-emerald-300 hover:text-emerald-200"
        >
          Open supplier source
        </a>
      ) : null}
    </div>
  );
}
