"use client";

import { Fragment, useEffect, useMemo, useState, type ReactNode } from "react";
import {
  BadgeCheck,
  Camera,
  CheckCircle2,
  ClipboardCheck,
  Database,
  FileSearch,
  Gauge,
  Loader2,
  RefreshCw,
  Send,
  ShieldCheck,
  ShoppingCart,
  Sparkles,
  Upload,
  Wrench,
  ExternalLink,
  ImageIcon,
  PackageCheck,
  Save,
  Search,
  Boxes,
} from "lucide-react";
import { api } from "@/lib/api";
import { supabase } from "@/lib/supabase";

type Job = {
  id: string;
  title: string;
  status: string;
  intake_mileage?: number;
  vehicles?: {
    id: string;
    vin?: string;
    make?: string;
    model?: string;
    year?: number;
    license_plate?: string;
    current_mileage?: number;
  };
};

type Photo = {
  id: string;
  image_url: string;
  photo_type?: string;
  caption?: string;
};

type EstimateLine = {
  id?: string;
  component_name: string;
  damage_type?: string;
  action?: string;
  labor_hours?: number;
  labor_cost?: number;
  parts_cost?: number;
  paint_cost?: number;
  line_total?: number;
  reasoning?: string;
};

type Estimate = {
  id: string;
  source: string;
  status: string;
  created_at?: string;
  total_parts: number;
  total_labor: number;
  total_paint: number;
  total_estimate: number;
  technician_estimate_lines?: EstimateLine[];
  lines?: EstimateLine[];
};

type PartQuote = {
  id: string;
  job_id: string;
  estimate_id?: string;
  estimate_line_id?: string;
  component_name: string;
  supplier_name: string;
  supplier_type?: string;
  part_condition?: string;
  part_number?: string;
  price: number;
  currency?: string;
  availability?: string;
  lead_time_days?: number;
  warranty_notes?: string;
  source_url?: string;
  quote_reference?: string;
  supplier_id?: string;
  product_title?: string;
  product_image_url?: string;
  image_url?: string;
  source_provider?: string;
  source_query?: string;
  source_rank?: number;
  external_product_id?: string;
  is_saved?: boolean;
  saved_at?: string;
  last_checked_at?: string;
  confidence?: number;
  is_recommended?: boolean;
  selected_for_estimate?: boolean;
};

type WorkspaceTab = "evidence" | "estimate" | "sourcing" | "approval";

const API_BASE = process.env.NEXT_PUBLIC_API_URL || "http://localhost:8000/api";

const currency = (value: any) =>
  `R ${Number(value || 0).toLocaleString("en-ZA", {
    minimumFractionDigits: 2,
    maximumFractionDigits: 2,
  })}`;

const openStatuses = new Set([
  "Assigned",
  "Inspection Started",
  "Diagnosis Done",
  "Estimate Drafted",
  "Awaiting Approval",
  "Approved",
  "Repair In Progress",
  "Waiting for Parts",
  "Quality Check",
]);

const sourceLabel = (source?: string) => {
  if (!source) return "LMG Estimate";
  if (["ai", "lmg_ai", "technician_adjusted"].includes(source)) return "LMG Estimate";
  if (source.includes("benchmark")) return "Benchmark";
  return source.replaceAll("_", " ");
};

const confidenceLabel = (value?: number) => {
  const n = Number(value || 0);
  if (!n) return "";
  return `${Math.round(n <= 1 ? n * 100 : n)}%`;
};

export default function TechnicianAiEstimatesPage() {
  const [jobs, setJobs] = useState<Job[]>([]);
  const [jobId, setJobId] = useState("");
  const [photos, setPhotos] = useState<Photo[]>([]);
  const [estimates, setEstimates] = useState<Estimate[]>([]);
  const [partQuotes, setPartQuotes] = useState<PartQuote[]>([]);
  const [evidencePackage, setEvidencePackage] = useState<any>(null);
  const [loading, setLoading] = useState(true);
  const [loadingJobData, setLoadingJobData] = useState(false);
  const [uploading, setUploading] = useState(false);
  const [generating, setGenerating] = useState(false);
  const [activeTab, setActiveTab] = useState<WorkspaceTab>("estimate");
  const [selectedLineId, setSelectedLineId] = useState("");
  const [sourcingLineId, setSourcingLineId] = useState<string | null>(null);
  const [quoteActionId, setQuoteActionId] = useState<string | null>(null);
  const [submitting, setSubmitting] = useState(false);
  const [file, setFile] = useState<File | null>(null);
  const [photoType, setPhotoType] = useState("damage");
  const [caption, setCaption] = useState("");

  const selectedJob = jobs.find((j) => j.id === jobId);

  const latest = useMemo(() => {
    const sorted = [...estimates].sort(
      (a, b) => new Date(b.created_at || 0).getTime() - new Date(a.created_at || 0).getTime()
    );

    return (
      sorted.find((e) => ["lmg_ai", "ai", "technician_adjusted"].includes(e.source)) ||
      sorted[0] ||
      null
    );
  }, [estimates]);

  const lines = latest?.technician_estimate_lines || latest?.lines || [];
  const evidenceScore = Number(evidencePackage?.job?.evidence_completeness_score || 0);
  const readinessStatus = evidencePackage?.job?.estimate_readiness_status || "not reviewed";
  const selectedVehicle = selectedJob?.vehicles;
  const selectedLine =
    lines.find((line) => line.id && line.id === selectedLineId) || lines[0] || null;

  const primaryPhoto = photos[0] || null;
  const selectedQuotes = partQuotes.filter((quote) => quote.selected_for_estimate);
  const selectedQuoteLineIds = new Set(selectedQuotes.map((quote) => quote.estimate_line_id).filter(Boolean));
  const replacementLines = lines.filter((line) =>
    String(line.action || "").toLowerCase().includes("replace")
  );
  const missingQuoteLines = replacementLines.filter((line) => line.id && !selectedQuoteLineIds.has(line.id));
  const canSubmitForApproval = Boolean(latest?.id && lines.length > 0 && missingQuoteLines.length === 0);

  useEffect(() => {
    if (!lines.length) {
      setSelectedLineId("");
      return;
    }

    if (!selectedLineId || !lines.some((line) => line.id === selectedLineId)) {
      setSelectedLineId(lines[0]?.id || "");
    }
  }, [lines, selectedLineId]);

  const loadJobs = async () => {
    const data = await api.get("/technicians/jobs");
    const open = (data || []).filter((j: Job) => openStatuses.has(j.status));

    setJobs(open);

    if ((!jobId || !open.some((job: Job) => job.id === jobId)) && open.length) {
      setJobId(open[0].id);
    }
  };

  const loadJobData = async (id: string) => {
    if (!id) return;

    setLoadingJobData(true);

    try {
      const [evidenceData, photoData, estimateData, quoteData] = await Promise.all([
        api.get(`/technicians/jobs/${id}/evidence-package`).catch(() => null),
        api.get(`/technicians/jobs/${id}/photos`).catch(() => []),
        api.get(`/technicians/jobs/${id}/estimates`).catch(() => []),
        api.get(`/technicians/parts/quotes?job_id=${id}`).catch(() => []),
      ]);

      setEvidencePackage(evidenceData);

      const mediaPhotos =
        evidenceData?.media?.map((m: any) => ({
          id: m.id,
          image_url: m.public_url || m.media_url || m.image_url,
          photo_type: m.evidence_slot || m.media_type || "evidence",
          caption: m.caption,
        })) || [];

      const mergedPhotos = [...mediaPhotos, ...(photoData || [])].filter((p: any) => p?.image_url);
      const uniquePhotos = Array.from(
        new Map(mergedPhotos.map((p: any) => [p.image_url, p])).values()
      ) as Photo[];

      setPhotos(uniquePhotos);
      setEstimates(estimateData || []);
      setPartQuotes(quoteData || []);
    } finally {
      setLoadingJobData(false);
    }
  };

  const refresh = async () => {
    setLoading(true);
    try {
      await loadJobs();
      if (jobId) await loadJobData(jobId);
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => {
    refresh();
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, []);

  useEffect(() => {
    if (jobId) loadJobData(jobId);
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [jobId]);

  const uploadPhoto = async () => {
    if (!jobId || !file) {
      alert("Choose a job and photo first.");
      return;
    }

    setUploading(true);

    try {
      const form = new FormData();
      form.append("file", file);
      form.append("media_type", "image");
      form.append("evidence_slot", photoType);
      form.append("photo_type", photoType);
      form.append("caption", caption);

      const { data: sessionData } = await supabase.auth.getSession();
      const token = sessionData.session?.access_token;

      if (!token) {
        throw new Error("Missing auth session. Please log out and log back in.");
      }

      const res = await fetch(`${API_BASE}/technicians/jobs/${jobId}/media`, {
        method: "POST",
        headers: { Authorization: `Bearer ${token}` },
        body: form,
      });

      if (!res.ok) throw new Error(await res.text());

      setFile(null);
      setCaption("");
      await loadJobData(jobId);
    } catch (err: any) {
      alert(err?.message || "Evidence upload failed.");
    } finally {
      setUploading(false);
    }
  };

  const generateLmgEstimate = async () => {
    if (!jobId) return;

    if (!photos.length) {
      alert("Upload at least one damage photo first.");
      return;
    }

    setGenerating(true);

    try {
      await api.post(`/technicians/jobs/${jobId}/ai-estimate`, {});
      await loadJobData(jobId);
    } catch (err: any) {
      alert(err?.message || "LMG estimate failed.");
    } finally {
      setGenerating(false);
    }
  };

  const sortedQuotesForLine = (line: EstimateLine) => {
    const name = (line.component_name || "").toLowerCase();

    return partQuotes
      .filter((quote) => {
        const quoteName = (quote.component_name || "").toLowerCase();

        return (
          (!!line.id && quote.estimate_line_id === line.id) ||
          (!!quoteName && !!name && (quoteName.includes(name) || name.includes(quoteName)))
        );
      })
      .sort((a, b) => {
        if (a.selected_for_estimate && !b.selected_for_estimate) return -1;
        if (!a.selected_for_estimate && b.selected_for_estimate) return 1;
        if (a.is_saved && !b.is_saved) return -1;
        if (!a.is_saved && b.is_saved) return 1;
        if (a.is_recommended && !b.is_recommended) return -1;
        if (!a.is_recommended && b.is_recommended) return 1;
        return Number(a.price || 0) - Number(b.price || 0);
      });
  };

  const quotesForLine = (line: EstimateLine, limit = 3) => {
    const quotes = sortedQuotesForLine(line);
    return limit > 0 ? quotes.slice(0, limit) : quotes;
  };

  const sourcePartsForLine = async (line: EstimateLine, refresh = false) => {
    if (!jobId || !line?.id) {
      alert("Select a saved estimate line first.");
      return;
    }

    setSourcingLineId(line.id);
    setSelectedLineId(line.id);
    setActiveTab("sourcing");

    try {
      const query = refresh ? "?refresh=true" : "";
      await api.post(`/technicians/jobs/${jobId}/estimate-lines/${line.id}/source-parts${query}`, {});
      await loadJobData(jobId);
    } catch (err: any) {
      alert(err?.message || "Could not source live suppliers.");
    } finally {
      setSourcingLineId(null);
    }
  };

  const saveQuoteSupplier = async (quote: PartQuote) => {
    if (!jobId) return;

    setQuoteActionId(quote.id);
    try {
      await api.post(`/technicians/parts/quotes/${quote.id}/save-supplier`, {});
      await loadJobData(jobId);
    } catch (err: any) {
      alert(err?.message || "Could not save supplier.");
    } finally {
      setQuoteActionId(null);
    }
  };

  const selectQuoteForEstimate = async (quote: PartQuote) => {
    if (!jobId) return;

    setQuoteActionId(quote.id);
    try {
      await api.post(`/technicians/parts/quotes/${quote.id}/select`, {});
      await loadJobData(jobId);
      setActiveTab("approval");
    } catch (err: any) {
      alert(err?.message || "Could not select supplier quote.");
    } finally {
      setQuoteActionId(null);
    }
  };

  const submitForApproval = async () => {
    if (!latest?.id || !jobId) return;

    if (!canSubmitForApproval) {
      alert("Select supplier quotes for all replacement lines before submitting.");
      setActiveTab("sourcing");
      return;
    }

    setSubmitting(true);

    try {
      await api.post(`/technicians/estimates/${latest.id}/submit`, {
        submitted_comment: `Submitted from LMG Estimate wizard with ${selectedQuotes.length} selected supplier quote(s).`,
      });

      await loadJobData(jobId);
      await loadJobs();
      setActiveTab("approval");
      alert("Submitted to admin for approval.");
    } catch (err: any) {
      alert(err?.message || "Could not submit estimate for approval.");
    } finally {
      setSubmitting(false);
    }
  };

  if (loading) {
    return (
      <div className="flex min-h-[70vh] items-center justify-center bg-[#07090d]">
        <div className="flex flex-col items-center gap-3 text-zinc-500">
          <Loader2 className="h-10 w-10 animate-spin text-emerald-400" />
          <p className="text-sm font-semibold">Preparing LMG estimate workspace...</p>
        </div>
      </div>
    );
  }

  return (
    <div className="-m-6 min-h-[calc(100vh-4rem)] bg-[#07090d] p-4 text-zinc-100 md:p-6">
      <div className="mx-auto flex max-w-[1800px] flex-col gap-6">
        <section className="relative overflow-hidden rounded-[2rem] border border-white/10 bg-gradient-to-br from-emerald-500/10 via-zinc-950 to-purple-500/10 p-5 shadow-2xl md:p-6">
          <div className="pointer-events-none absolute -right-24 -top-24 h-72 w-72 rounded-full bg-emerald-500/20 blur-3xl" />
          <div className="pointer-events-none absolute -bottom-32 left-1/3 h-72 w-72 rounded-full bg-purple-500/20 blur-3xl" />

          <div className="relative flex flex-col gap-5 xl:flex-row xl:items-end xl:justify-between">
            <div>
              <div className="inline-flex items-center gap-2 rounded-full border border-emerald-500/20 bg-emerald-500/10 px-3 py-1 text-xs font-black uppercase tracking-[0.22em] text-emerald-300">
                <Sparkles size={13} />
                LMG Estimate Studio
              </div>

              <h1 className="mt-4 text-3xl font-black tracking-tight text-white md:text-4xl">
                Evidence-led repair estimate
              </h1>

              <p className="mt-2 max-w-3xl text-sm leading-6 text-zinc-400">
                Build an internal LMG estimate from job evidence, technician intake, pricing rules,
                repair lines and trusted supplier comparison options.
              </p>
            </div>

            <div className="flex flex-wrap items-center gap-3">
              <button
                onClick={refresh}
                className="inline-flex items-center gap-2 rounded-xl border border-white/10 bg-black/40 px-4 py-3 text-sm font-bold text-zinc-300 hover:border-emerald-500/50 hover:text-white"
              >
                <RefreshCw size={16} />
                Refresh
              </button>

              <button
                onClick={generateLmgEstimate}
                disabled={generating || !jobId || photos.length === 0}
                className="inline-flex items-center gap-2 rounded-xl bg-emerald-500 px-5 py-3 text-sm font-black text-black shadow-[0_0_35px_rgba(16,185,129,0.25)] hover:bg-emerald-400 disabled:cursor-not-allowed disabled:opacity-50"
              >
                {generating ? <Loader2 className="animate-spin" size={16} /> : <Send size={16} />}
                Generate LMG Estimate
              </button>
            </div>
          </div>

          <div className="relative mt-6 grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
            <MetricCard
              title="Open job cards"
              value={jobs.length}
              detail="Available for estimate"
              icon={<ClipboardCheck size={18} />}
            />
            <MetricCard
              title="Evidence items"
              value={photos.length}
              detail={loadingJobData ? "Refreshing..." : "Photos linked to selected job"}
              icon={<Camera size={18} />}
            />
            <MetricCard
              title="Supplier options"
              value={partQuotes.length}
              detail="Trusted quote candidates"
              icon={<ShoppingCart size={18} />}
            />
            <MetricCard
              title="Readiness"
              value={`${evidenceScore}%`}
              detail={readinessStatus}
              icon={<Gauge size={18} />}
            />
          </div>
        </section>

        <div className="flex flex-wrap gap-2 rounded-[1.5rem] border border-white/10 bg-[#10131b]/80 p-2">
          <WorkspaceTabButton active={activeTab === "evidence"} onClick={() => setActiveTab("evidence")} icon={<Camera size={15} />} label="Evidence" />
          <WorkspaceTabButton active={activeTab === "estimate"} onClick={() => setActiveTab("estimate")} icon={<Wrench size={15} />} label="Repair Estimate" />
          <WorkspaceTabButton active={activeTab === "sourcing"} onClick={() => setActiveTab("sourcing")} icon={<ShoppingCart size={15} />} label="Supplier Sourcing" />
          <WorkspaceTabButton active={activeTab === "approval"} onClick={() => setActiveTab("approval")} icon={<PackageCheck size={15} />} label="Approval Review" />
        </div>

        <div className="grid gap-4 rounded-[1.5rem] border border-white/10 bg-[#10131b]/85 p-4 lg:grid-cols-[240px_minmax(0,1fr)_260px]">
          <div className="overflow-hidden rounded-2xl border border-white/10 bg-black">
            {primaryPhoto ? (
              <img src={primaryPhoto.image_url} alt="" className="h-36 w-full object-cover" />
            ) : (
              <div className="flex h-36 items-center justify-center text-xs font-bold text-zinc-600">
                No evidence image
              </div>
            )}
          </div>

          <div className="flex flex-col justify-center">
            <p className="text-xs font-black uppercase tracking-[0.22em] text-emerald-400">
              Current wizard step
            </p>
            <h2 className="mt-2 text-2xl font-black text-white">
              {activeTab === "evidence"
                ? "Evidence review"
                : activeTab === "estimate"
                  ? "Repair estimate"
                  : activeTab === "sourcing"
                    ? "Supplier sourcing"
                    : "Approval review"}
            </h2>
            <p className="mt-2 text-sm leading-6 text-zinc-400">
              {selectedJob?.title || "Select a job"} · {selectedVehicle?.year || "-"} {selectedVehicle?.make || "-"} {selectedVehicle?.model || ""}
            </p>
          </div>

          <div className="grid grid-cols-2 gap-2">
            <TinyStat title="Lines" value={lines.length} />
            <TinyStat title="Selected quotes" value={selectedQuotes.length} />
            <TinyStat title="Missing quotes" value={missingQuoteLines.length} />
            <TinyStat title="Total" value={currency(latest?.total_estimate)} />
          </div>
        </div>

        <div className="grid gap-6 xl:grid-cols-[420px_minmax(0,1fr)]">
          <aside className={activeTab === "evidence" ? "space-y-6" : "hidden xl:block xl:space-y-6"}>
            <Panel>
              <PanelTitle icon={<FileSearch size={18} />} title="Selected job card" />

              <label className="mt-5 block text-xs font-black uppercase tracking-[0.18em] text-zinc-500">
                Open job
              </label>

              <select
                value={jobId}
                onChange={(e) => setJobId(e.target.value)}
                className="mt-2 w-full rounded-xl border border-white/10 bg-black px-4 py-3 text-sm font-semibold text-white outline-none focus:border-emerald-500/70"
              >
                {jobs.length === 0 ? (
                  <option>No open jobs available</option>
                ) : (
                  jobs.map((job) => (
                    <option key={job.id} value={job.id}>
                      {job.title} — {job.vehicles?.make} {job.vehicles?.model}{" "}
                      ({job.vehicles?.license_plate || job.vehicles?.vin || "no plate"})
                    </option>
                  ))
                )}
              </select>

              {selectedJob ? (
                <div className="mt-5 space-y-3">
                  <div className="rounded-2xl border border-emerald-500/20 bg-emerald-500/10 p-4">
                    <p className="text-xs font-black uppercase tracking-[0.18em] text-emerald-300">
                      Vehicle
                    </p>
                    <h2 className="mt-2 text-xl font-black text-white">
                      {selectedVehicle?.year || "-"} {selectedVehicle?.make || "-"}{" "}
                      {selectedVehicle?.model || ""}
                    </h2>
                    <p className="mt-1 text-sm text-zinc-400">
                      {selectedVehicle?.license_plate || "No plate"} ·{" "}
                      {selectedVehicle?.vin || "VIN not captured"}
                    </p>
                  </div>

                  <div className="grid grid-cols-2 gap-3">
                    <TinyStat title="Status" value={selectedJob.status} />
                    <TinyStat
                      title="Mileage"
                      value={selectedJob.intake_mileage || selectedVehicle?.current_mileage || "-"}
                    />
                  </div>
                </div>
              ) : (
                <EmptyState text="Create or assign a job card first." />
              )}
            </Panel>

            <Panel>
              <PanelTitle icon={<BadgeCheck size={18} />} title="Evidence readiness" />

              <div className="mt-5">
                <div className="mb-2 flex items-center justify-between text-xs">
                  <span className="font-bold uppercase tracking-wider text-zinc-500">
                    Completion
                  </span>
                  <span className="font-black text-emerald-300">{evidenceScore}%</span>
                </div>
                <div className="h-3 overflow-hidden rounded-full bg-black">
                  <div
                    className="h-full rounded-full bg-emerald-400 transition-all"
                    style={{ width: `${Math.max(0, Math.min(100, evidenceScore))}%` }}
                  />
                </div>
              </div>

              <div className="mt-4 rounded-2xl border border-white/10 bg-black/50 p-4">
                <p className="text-xs font-black uppercase tracking-[0.18em] text-zinc-500">
                  Status
                </p>
                <p className="mt-2 text-sm font-bold text-white">{readinessStatus}</p>
              </div>
            </Panel>

            <Panel>
              <PanelTitle icon={<Upload size={18} />} title="Capture evidence" />

              <div className="mt-5 space-y-3">
                <input
                  type="file"
                  accept="image/*"
                  onChange={(e) => setFile(e.target.files?.[0] || null)}
                  className="w-full cursor-pointer rounded-xl border border-white/10 bg-black px-3 py-3 text-sm text-zinc-300 file:mr-3 file:rounded-lg file:border-0 file:bg-emerald-500 file:px-3 file:py-2 file:text-xs file:font-black file:text-black"
                />

                <select
                  value={photoType}
                  onChange={(e) => setPhotoType(e.target.value)}
                  className="w-full rounded-xl border border-white/10 bg-black px-3 py-3 text-sm font-semibold text-white outline-none focus:border-emerald-500/70"
                >
                  <option value="damage">Damage</option>
                  <option value="front">Front</option>
                  <option value="rear">Rear</option>
                  <option value="left">Left</option>
                  <option value="right">Right</option>
                  <option value="vin_plate">VIN Plate</option>
                  <option value="odometer">Odometer</option>
                  <option value="before">Before</option>
                  <option value="after">After</option>
                  <option value="other">Other</option>
                </select>

                <input
                  value={caption}
                  onChange={(e) => setCaption(e.target.value)}
                  placeholder="Evidence caption"
                  className="w-full rounded-xl border border-white/10 bg-black px-3 py-3 text-sm text-white outline-none placeholder:text-zinc-600 focus:border-emerald-500/70"
                />

                <button
                  onClick={uploadPhoto}
                  disabled={uploading || !file || !jobId}
                  className="inline-flex w-full items-center justify-center gap-2 rounded-xl bg-emerald-500 px-4 py-3 text-sm font-black text-black hover:bg-emerald-400 disabled:cursor-not-allowed disabled:opacity-50"
                >
                  {uploading ? <Loader2 className="animate-spin" size={16} /> : <Upload size={16} />}
                  Upload Evidence
                </button>
              </div>
            </Panel>

            <Panel>
              <PanelTitle icon={<Camera size={18} />} title="Evidence gallery" />

              <div className="mt-5 grid gap-3">
                {photos.length === 0 ? (
                  <EmptyState text="No evidence uploaded yet." />
                ) : (
                  photos.map((photo, index) => (
                    <div
                      key={`${photo.id}-${photo.image_url}-${index}`}
                      className="overflow-hidden rounded-2xl border border-white/10 bg-black"
                    >
                      <img src={photo.image_url} alt="" className="h-44 w-full object-cover" />
                      <div className="p-3">
                        <p className="text-xs font-black uppercase tracking-wider text-emerald-300">
                          {photo.photo_type || "evidence"}
                        </p>
                        <p className="mt-1 text-sm leading-5 text-zinc-400">
                          {photo.caption || "No caption captured."}
                        </p>
                      </div>
                    </div>
                  ))
                )}
              </div>
            </Panel>
          </aside>

          <main className="min-w-0">
            {activeTab === "estimate" && (
            <Panel>
              <div className="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
                <div>
                  <PanelTitle icon={<Sparkles size={18} />} title="LMG Estimate" />
                  <p className="mt-2 max-w-3xl text-sm leading-6 text-zinc-400">
                    Review the generated LMG estimate, repair lines, labour, parts, paint and
                    trusted supplier options before submitting approval from the job card.
                  </p>
                </div>

                <div className="flex flex-wrap gap-2">
                  <InfoPill icon={<ShieldCheck size={14} />} label="Evidence checked" />
                  <InfoPill icon={<Database size={14} />} label="Internal pricing" />
                  <InfoPill icon={<ShoppingCart size={14} />} label="Supplier comparison" />
                </div>
              </div>

              {!latest ? (
                <div className="mt-6 rounded-[2rem] border border-dashed border-white/10 bg-black/40 p-10 text-center">
                  <div className="mx-auto flex h-16 w-16 items-center justify-center rounded-2xl border border-emerald-500/20 bg-emerald-500/10 text-emerald-300">
                    <Sparkles size={28} />
                  </div>
                  <h3 className="mt-5 text-xl font-black text-white">No LMG estimate yet</h3>
                  <p className="mx-auto mt-2 max-w-xl text-sm leading-6 text-zinc-500">
                    Upload evidence, confirm the job card details, then generate the LMG estimate.
                    The output will include repair lines and supplier quote placeholders where quotes are missing.
                  </p>
                </div>
              ) : (
                <div className="mt-6 space-y-5">
                  <div className="grid gap-3 md:grid-cols-2 xl:grid-cols-4">
                    <TotalCard title="Parts" value={currency(latest.total_parts)} icon={<Database size={18} />} />
                    <TotalCard title="Labour" value={currency(latest.total_labor)} icon={<Wrench size={18} />} />
                    <TotalCard title="Paint" value={currency(latest.total_paint)} icon={<Camera size={18} />} />
                    <TotalCard title="Total" value={currency(latest.total_estimate)} icon={<CheckCircle2 size={18} />} strong />
                  </div>

                  <div className="grid gap-3 md:grid-cols-4">
                    <TinyStat title="Estimate source" value={sourceLabel(latest.source)} />
                    <TinyStat title="Estimate status" value={latest.status || "-"} />
                    <TinyStat title="Repair lines" value={lines.length} />
                    <TinyStat title="Quote options" value={partQuotes.length} />
                  </div>

                  <div className="overflow-hidden rounded-[1.5rem] border border-white/10 bg-black">
                    <div className="flex items-center justify-between border-b border-white/10 px-5 py-4">
                      <div>
                        <h3 className="font-black text-white">Repair line breakdown</h3>
                        <p className="mt-1 text-xs text-zinc-500">
                          Parts pricing should be validated against at least 3 trusted supplier options where available.
                        </p>
                      </div>
                    </div>

                    <div className="overflow-x-auto">
                      <table className="w-full min-w-[980px] text-left text-sm">
                        <thead className="bg-white/[0.03] text-xs uppercase tracking-wider text-zinc-500">
                          <tr>
                            <th className="px-5 py-3">Component</th>
                            <th className="px-5 py-3">Action</th>
                            <th className="px-5 py-3">Labour</th>
                            <th className="px-5 py-3">Parts</th>
                            <th className="px-5 py-3">Paint</th>
                            <th className="px-5 py-3 text-right">Total</th>
                          </tr>
                        </thead>

                        <tbody className="divide-y divide-white/10">
                          {lines.map((line, index) => {
                            const quotes = quotesForLine(line);

                            return (
                              <Fragment key={line.id || `${line.component_name}-${index}`}>
                                <tr className="align-top">
                                  <td className="px-5 py-4">
                                    <p className="font-black text-white">{line.component_name}</p>
                                    <p className="mt-1 max-w-xl text-xs leading-5 text-zinc-500">
                                      {line.reasoning || "No reasoning captured for this line."}
                                    </p>
                                  </td>
                                  <td className="px-5 py-4 text-zinc-300">{line.action || "-"}</td>
                                  <td className="px-5 py-4 text-zinc-300">{line.labor_hours || 0}h</td>
                                  <td className="px-5 py-4 text-zinc-300">{currency(line.parts_cost)}</td>
                                  <td className="px-5 py-4 text-zinc-300">{currency(line.paint_cost)}</td>
                                  <td className="px-5 py-4 text-right font-black text-white">
                                    {currency(line.line_total)}
                                  </td>
                                </tr>

                                <tr className="bg-zinc-950/70">
                                  <td colSpan={6} className="px-5 pb-5">
                                    <div className="rounded-2xl border border-white/10 bg-[#080a0f] p-4">
                                      <div className="mb-3 flex flex-col gap-3 lg:flex-row lg:items-center lg:justify-between">
                                        <button
                                          type="button"
                                          onClick={() => {
                                            setSelectedLineId(line.id || "");
                                            setActiveTab("sourcing");
                                          }}
                                          className="flex items-center gap-2 text-left text-xs font-black uppercase tracking-[0.18em] text-emerald-300 hover:text-emerald-200"
                                        >
                                          <ShoppingCart size={14} />
                                          Trusted parts options
                                        </button>

                                        <div className="flex flex-wrap items-center gap-2">
                                          <span className="rounded-full border border-white/10 bg-white/[0.03] px-2.5 py-1 text-[10px] font-bold text-zinc-500">
                                            {quotes.length}/3 linked
                                          </span>
                                          <button
                                            type="button"
                                            onClick={() => sourcePartsForLine(line)}
                                            disabled={!line.id || sourcingLineId === line.id}
                                            className="inline-flex items-center gap-2 rounded-lg border border-emerald-500/30 bg-emerald-500/10 px-3 py-1.5 text-[10px] font-black text-emerald-300 hover:bg-emerald-500/20 disabled:cursor-not-allowed disabled:opacity-50"
                                          >
                                            {sourcingLineId === line.id ? <Loader2 className="animate-spin" size={12} /> : <Search size={12} />}
                                            {sourcingLineId === line.id ? "Searching" : "Find live"}
                                          </button>
                                        </div>
                                      </div>

                                      {quotes.length === 0 ? (
                                        <p className="text-xs leading-5 text-zinc-500">
                                          No supplier quotes linked yet. Add OEM, aftermarket and used/refurbished options
                                          before final approval where the part requires replacement.
                                        </p>
                                      ) : (
                                        <div className="grid gap-3 lg:grid-cols-3">
                                          {quotes.map((quote) => (
                                            <QuoteCard key={quote.id} quote={quote} />
                                          ))}
                                        </div>
                                      )}
                                    </div>
                                  </td>
                                </tr>
                              </Fragment>
                            );
                          })}
                        </tbody>
                      </table>
                    </div>
                  </div>
                </div>
              )}
            </Panel>
            )}

            {activeTab === "sourcing" && (
              <Panel>
                <div className="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
                  <div>
                    <PanelTitle icon={<ShoppingCart size={18} />} title="Supplier sourcing workspace" />
                    <p className="mt-2 max-w-3xl text-sm leading-6 text-zinc-400">
                      Select a repair line, pull live supplier options, review product images and save the supplier before selecting the quote for the estimate.
                    </p>
                  </div>

                  {selectedLine ? (
                    <button
                      onClick={() => sourcePartsForLine(selectedLine, true)}
                      disabled={!selectedLine.id || sourcingLineId === selectedLine.id}
                      className="inline-flex items-center gap-2 rounded-xl bg-emerald-500 px-4 py-3 text-sm font-black text-black hover:bg-emerald-400 disabled:cursor-not-allowed disabled:opacity-50"
                    >
                      {sourcingLineId === selectedLine.id ? <Loader2 className="animate-spin" size={16} /> : <Search size={16} />}
                      {sourcingLineId === selectedLine.id ? "Searching live suppliers" : "Refresh live suppliers"}
                    </button>
                  ) : null}
                </div>

                {!latest || lines.length === 0 ? (
                  <EmptyState text="Generate an LMG estimate first, then supplier sourcing will appear here." />
                ) : (
                  <div className="mt-6 grid gap-5 xl:grid-cols-[360px_minmax(0,1fr)]">
                    <div className="rounded-2xl border border-white/10 bg-black/40 p-3">
                      <div className="mb-3 flex items-center gap-2 px-2 text-xs font-black uppercase tracking-[0.18em] text-zinc-500">
                        <Boxes size={14} />
                        Repair lines
                      </div>

                      <div className="space-y-2">
                        {lines.map((line, index) => {
                          const selected = selectedLine?.id === line.id || (!selectedLine?.id && index === 0);
                          const count = quotesForLine(line, 0).length;

                          return (
                            <button
                              key={line.id || `${line.component_name}-${index}`}
                              onClick={() => setSelectedLineId(line.id || "")}
                              className={
                                selected
                                  ? "w-full rounded-xl border border-emerald-500/40 bg-emerald-500/10 p-3 text-left"
                                  : "w-full rounded-xl border border-white/10 bg-black p-3 text-left hover:border-emerald-500/30"
                              }
                            >
                              <p className="line-clamp-2 text-sm font-black text-white">{line.component_name}</p>
                              <div className="mt-2 flex items-center justify-between text-xs text-zinc-500">
                                <span>{line.action || "Action pending"}</span>
                                <span>{count} supplier option(s)</span>
                              </div>
                            </button>
                          );
                        })}
                      </div>
                    </div>

                    <div className="min-w-0">
                      {selectedLine ? (
                        <div className="rounded-2xl border border-white/10 bg-black/40 p-4">
                          <div className="flex flex-col gap-3 lg:flex-row lg:items-start lg:justify-between">
                            <div>
                              <p className="text-xs font-black uppercase tracking-[0.18em] text-emerald-300">Selected component</p>
                              <h3 className="mt-2 text-xl font-black text-white">{selectedLine.component_name}</h3>
                              <p className="mt-1 text-sm text-zinc-500">
                                {selectedLine.action || "Action pending"} · Estimate parts cost {currency(selectedLine.parts_cost)}
                              </p>
                            </div>

                            <button
                              onClick={() => sourcePartsForLine(selectedLine)}
                              disabled={!selectedLine.id || sourcingLineId === selectedLine.id}
                              className="inline-flex items-center justify-center gap-2 rounded-xl border border-emerald-500/30 bg-emerald-500/10 px-4 py-3 text-sm font-black text-emerald-300 hover:bg-emerald-500/20 disabled:cursor-not-allowed disabled:opacity-50"
                            >
                              {sourcingLineId === selectedLine.id ? <Loader2 className="animate-spin" size={15} /> : <Search size={15} />}
                              {sourcingLineId === selectedLine.id ? "Searching" : "Find live suppliers"}
                            </button>
                          </div>

                          <div className="mt-5">
                            {quotesForLine(selectedLine, 0).length === 0 ? (
                              <EmptyState text="No supplier options saved for this line yet. Click Find live suppliers to pull supplier candidates with prices, images and source links." />
                            ) : (
                              <div className="grid gap-4 md:grid-cols-2 2xl:grid-cols-3">
                                {quotesForLine(selectedLine, 0).map((quote) => (
                                  <QuoteCard
                                    key={quote.id}
                                    quote={quote}
                                    busy={quoteActionId === quote.id}
                                    onSave={() => saveQuoteSupplier(quote)}
                                    onSelect={() => selectQuoteForEstimate(quote)}
                                  />
                                ))}
                              </div>
                            )}
                          </div>
                        </div>
                      ) : (
                        <EmptyState text="Select a repair line to start sourcing suppliers." />
                      )}
                    </div>
                  </div>
                )}
              </Panel>
            )}

            {activeTab === "evidence" && (
              <Panel>
                <PanelTitle icon={<Camera size={18} />} title="Evidence review" />
                <p className="mt-2 text-sm leading-6 text-zinc-400">
                  Evidence remains visible on the left. This workspace confirms readiness, missing items and uploaded media before estimating.
                </p>
                <div className="mt-5 grid gap-3 md:grid-cols-3">
                  <TinyStat title="Evidence score" value={`${evidenceScore}%`} />
                  <TinyStat title="Readiness" value={readinessStatus} />
                  <TinyStat title="Media items" value={photos.length} />
                </div>
              </Panel>
            )}

            {activeTab === "approval" && (
              <Panel>
                <div className="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
                  <div>
                    <PanelTitle icon={<PackageCheck size={18} />} title="Approval review" />
                    <p className="mt-2 max-w-3xl text-sm leading-6 text-zinc-400">
                      Final check before admin review. This submission includes the estimate total, evidence, repair lines and selected supplier source prices.
                    </p>
                  </div>

                  <button
                    onClick={submitForApproval}
                    disabled={!canSubmitForApproval || submitting}
                    className="inline-flex items-center justify-center gap-2 rounded-xl bg-emerald-500 px-5 py-3 text-sm font-black text-black hover:bg-emerald-400 disabled:cursor-not-allowed disabled:opacity-50"
                  >
                    {submitting ? <Loader2 className="animate-spin" size={16} /> : <Send size={16} />}
                    {submitting ? "Submitting..." : "Submit to admin"}
                  </button>
                </div>

                <div className="mt-6 grid gap-3 md:grid-cols-4">
                  <TinyStat title="Estimate status" value={latest?.status || "No estimate"} />
                  <TinyStat title="Repair lines" value={lines.length} />
                  <TinyStat title="Selected quotes" value={selectedQuotes.length} />
                  <TinyStat title="Missing quotes" value={missingQuoteLines.length} />
                </div>

                <div className="mt-6 grid gap-5 xl:grid-cols-[320px_minmax(0,1fr)]">
                  <div className="rounded-2xl border border-white/10 bg-black/40 p-4">
                    <p className="text-xs font-black uppercase tracking-[0.18em] text-emerald-300">
                      Evidence image
                    </p>
                    <div className="mt-3 overflow-hidden rounded-xl border border-white/10 bg-black">
                      {primaryPhoto ? (
                        <img src={primaryPhoto.image_url} alt="" className="h-52 w-full object-cover" />
                      ) : (
                        <div className="flex h-52 items-center justify-center text-sm text-zinc-600">No evidence image</div>
                      )}
                    </div>
                    <p className="mt-3 text-xs leading-5 text-zinc-500">
                      {primaryPhoto?.caption || "Evidence caption not captured."}
                    </p>
                  </div>

                  <div className="rounded-2xl border border-white/10 bg-black/40 p-4">
                    <p className="text-xs font-black uppercase tracking-[0.18em] text-emerald-300">
                      Selected supplier prices sent to admin
                    </p>

                    {selectedQuotes.length === 0 ? (
                      <EmptyState text="No supplier quote selected yet. Go to Supplier Sourcing and click Use this quote." />
                    ) : (
                      <div className="mt-4 space-y-3">
                        {selectedQuotes.map((quote) => (
                          <div key={quote.id} className="flex flex-col gap-3 rounded-xl border border-white/10 bg-black p-3 md:flex-row md:items-center md:justify-between">
                            <div>
                              <p className="font-black text-white">{quote.component_name}</p>
                              <p className="mt-1 text-xs text-zinc-500">
                                {quote.supplier_name} · {quote.product_title || quote.quote_reference || "Supplier source"}
                              </p>
                              {quote.source_url ? (
                                <a href={quote.source_url} target="_blank" rel="noreferrer" className="mt-2 inline-flex text-xs font-bold text-emerald-300">
                                  Open source
                                </a>
                              ) : null}
                            </div>
                            <div className="text-left md:text-right">
                              <p className="text-lg font-black text-white">{currency(quote.price)}</p>
                              <p className="text-xs text-zinc-500">{quote.source_provider || quote.supplier_type || "supplier"}</p>
                            </div>
                          </div>
                        ))}
                      </div>
                    )}

                    {missingQuoteLines.length > 0 && (
                      <div className="mt-5 rounded-xl border border-amber-500/30 bg-amber-500/10 p-4 text-sm text-amber-200">
                        Select supplier quotes for these replacement lines before submitting:
                        <ul className="mt-2 list-disc pl-5">
                          {missingQuoteLines.map((line) => (
                            <li key={line.id || line.component_name}>{line.component_name}</li>
                          ))}
                        </ul>
                      </div>
                    )}
                  </div>
                </div>
              </Panel>
            )}
          </main>
        </div>
      </div>
    </div>
  );
}

function Panel({ children }: { children: ReactNode }) {
  return (
    <section className="rounded-[1.75rem] border border-white/10 bg-[#10131b]/90 p-5 shadow-2xl backdrop-blur">
      {children}
    </section>
  );
}

function PanelTitle({ icon, title }: { icon: ReactNode; title: string }) {
  return (
    <div className="flex items-center gap-2">
      <span className="text-emerald-300">{icon}</span>
      <h2 className="font-black text-white">{title}</h2>
    </div>
  );
}

function MetricCard({
  title,
  value,
  detail,
  icon,
}: {
  title: string;
  value: any;
  detail: string;
  icon: ReactNode;
}) {
  return (
    <div className="rounded-2xl border border-white/10 bg-black/40 p-4 backdrop-blur">
      <div className="flex items-center justify-between">
        <p className="text-xs font-black uppercase tracking-[0.18em] text-zinc-500">{title}</p>
        <span className="text-emerald-300">{icon}</span>
      </div>
      <p className="mt-3 text-2xl font-black text-white">{value}</p>
      <p className="mt-1 text-xs text-zinc-500">{detail}</p>
    </div>
  );
}

function TotalCard({
  title,
  value,
  icon,
  strong,
}: {
  title: string;
  value: string;
  icon: ReactNode;
  strong?: boolean;
}) {
  return (
    <div
      className={
        strong
          ? "rounded-2xl border border-emerald-500/30 bg-emerald-500/10 p-4"
          : "rounded-2xl border border-white/10 bg-black/60 p-4"
      }
    >
      <div className="flex items-center justify-between">
        <p className="text-xs font-black uppercase tracking-[0.18em] text-zinc-500">{title}</p>
        <span className={strong ? "text-emerald-300" : "text-zinc-400"}>{icon}</span>
      </div>
      <p className="mt-3 truncate text-xl font-black text-white">{value}</p>
    </div>
  );
}

function TinyStat({ title, value }: { title: string; value: any }) {
  return (
    <div className="rounded-2xl border border-white/10 bg-black/50 p-4">
      <p className="text-[10px] font-black uppercase tracking-[0.18em] text-zinc-500">{title}</p>
      <p className="mt-2 truncate text-sm font-bold text-white">{value}</p>
    </div>
  );
}

function InfoPill({ icon, label }: { icon: ReactNode; label: string }) {
  return (
    <span className="inline-flex items-center gap-2 rounded-full border border-emerald-500/20 bg-emerald-500/10 px-3 py-1.5 text-xs font-bold text-emerald-300">
      {icon}
      {label}
    </span>
  );
}

function EmptyState({ text }: { text: string }) {
  return (
    <div className="rounded-2xl border border-dashed border-white/10 bg-black/30 p-8 text-center text-sm text-zinc-500">
      {text}
    </div>
  );
}

function WorkspaceTabButton({
  active,
  onClick,
  icon,
  label,
}: {
  active: boolean;
  onClick: () => void;
  icon: ReactNode;
  label: string;
}) {
  return (
    <button
      onClick={onClick}
      className={
        active
          ? "inline-flex items-center gap-2 rounded-xl bg-emerald-500 px-4 py-2.5 text-sm font-black text-black"
          : "inline-flex items-center gap-2 rounded-xl px-4 py-2.5 text-sm font-bold text-zinc-400 hover:bg-white/5 hover:text-white"
      }
    >
      {icon}
      {label}
    </button>
  );
}

function QuoteCard({
  quote,
  onSave,
  onSelect,
  busy,
}: {
  quote: PartQuote;
  onSave?: () => void;
  onSelect?: () => void;
  busy?: boolean;
}) {
  const confidence = confidenceLabel(quote.confidence);
  const imageUrl = quote.product_image_url || quote.image_url;

  return (
    <div className="overflow-hidden rounded-2xl border border-white/10 bg-black">
      <div className="relative h-40 border-b border-white/10 bg-zinc-950">
        {imageUrl ? (
          <img src={imageUrl} alt={quote.product_title || quote.component_name} className="h-full w-full object-cover" />
        ) : (
          <div className="flex h-full items-center justify-center text-zinc-700">
            <ImageIcon size={34} />
          </div>
        )}

        <div className="absolute left-3 top-3 flex flex-wrap gap-2">
          {quote.selected_for_estimate ? (
            <span className="rounded-full bg-emerald-500 px-2 py-1 text-[10px] font-black text-black">Selected</span>
          ) : quote.is_recommended ? (
            <span className="rounded-full bg-emerald-500/90 px-2 py-1 text-[10px] font-black text-black">Recommended</span>
          ) : null}

          {quote.is_saved ? (
            <span className="rounded-full bg-cyan-500/90 px-2 py-1 text-[10px] font-black text-black">Supplier saved</span>
          ) : null}
        </div>
      </div>

      <div className="p-4">
        <div className="min-w-0">
          <p className="truncate font-black text-white">{quote.supplier_name}</p>
          <p className="mt-1 line-clamp-2 text-xs leading-5 text-zinc-500">
            {quote.product_title || quote.quote_reference || quote.component_name}
          </p>
        </div>

        <p className="mt-4 text-2xl font-black text-white">{currency(quote.price)}</p>

        <div className="mt-3 space-y-1 text-xs text-zinc-500">
          <p>{quote.availability || "Availability unknown"}</p>
          <p>{quote.supplier_type || "supplier"} · {quote.part_condition || "condition unknown"}</p>
          {quote.lead_time_days ? <p>Lead time: {quote.lead_time_days} day(s)</p> : null}
          {quote.part_number ? <p>Part no: {quote.part_number}</p> : null}
          {quote.source_provider ? <p>Source: {quote.source_provider}</p> : null}
          {confidence ? <p>Confidence: {confidence}</p> : null}
          {quote.warranty_notes ? <p>{quote.warranty_notes}</p> : null}
        </div>

        {(onSave || onSelect || quote.source_url) && (
          <div className="mt-4 flex flex-wrap gap-2">
            {onSave ? (
              <button
                type="button"
                onClick={onSave}
                disabled={busy || quote.is_saved}
                className="inline-flex items-center gap-2 rounded-lg border border-white/10 bg-white/[0.03] px-3 py-2 text-xs font-black text-zinc-300 hover:border-cyan-500/40 hover:text-white disabled:cursor-not-allowed disabled:opacity-50"
              >
                {busy ? <Loader2 className="animate-spin" size={13} /> : <Save size={13} />}
                {quote.is_saved ? "Saved" : "Save supplier"}
              </button>
            ) : null}

            {onSelect ? (
              <button
                type="button"
                onClick={onSelect}
                disabled={busy || quote.selected_for_estimate}
                className="inline-flex items-center gap-2 rounded-lg bg-emerald-500 px-3 py-2 text-xs font-black text-black hover:bg-emerald-400 disabled:cursor-not-allowed disabled:opacity-50"
              >
                {busy ? <Loader2 className="animate-spin" size={13} /> : <PackageCheck size={13} />}
                {quote.selected_for_estimate ? "Using quote" : "Use this quote"}
              </button>
            ) : null}

            {quote.source_url ? (
              <a
                href={quote.source_url}
                target="_blank"
                rel="noreferrer"
